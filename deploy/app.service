# Example systemd user unit. Copy to ~/.config/systemd/user/<name>.service, adjust the two paths, then:
#   systemctl --user daemon-reload && systemctl --user enable --now <name>
# The unit starts the app through its console script, so it cannot drift from the repo: if the entry point moves,
# `uv run app` still works, and `app serve --help` is the contract.
[Unit]
Description=python-app-template
After=network.target

[Service]
WorkingDirectory=%h/path/to/checkout
# `--locked` refuses to start if uv.lock and pyproject.toml disagree, instead of silently changing the environment.
ExecStart=uv run --locked --no-dev app serve --host 127.0.0.1 --port 8360
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

{
  "name": "python-app-template-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "npm run typecheck && vp build",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "test": "vp test",
    "test:unit": "vp test run --project unit",
    "test:integration": "vp test run --project integration",
    "test:coverage": "vp test run --project unit --coverage",
    "test:coverage:all": "vp test run --coverage",
    "test:coverage:gate": "vp test run --coverage --config vitest.gate.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet -o storybook-static",
    "build:visual": "vp build --outDir dist-visual --emptyOutDir",
    "test:visual": "npm run build:visual && npm run build-storybook && strata-visual",
    "test:visual:update": "npm run build:visual && npm run build-storybook && strata-visual --update",
    "lint": "vp check --deny-warnings",
    "format": "vp fmt",
    "api-types": "strata-api-types openapi.json -o src/api.generated.ts",
    "api-types:check": "strata-api-types openapi.json -o src/api.generated.ts --check"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@tanstack/react-query": "^5.108.4",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "strata-react": "^1.3.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.1",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "msw-storybook-addon": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.65.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "typescript7": "npm:typescript@~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vitest": "5.1.1",
    "vite-plus": "1.8.0"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "vite-plus": "$vite-plus",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vitest": "5.1.1"
  }
}
